#!/usr/bin/env zsh

# ==========================================
# WARP - Terminal-specific configuration
# Only runs when $TERM_PROGRAM == WarpTerminal,
# so the file is safe in iTerm/Terminal/VS Code.
# ==========================================

# ==========================================
# WARPIFY SUBSHELLS - Blocks and autocomplete in nested shells
# Without this, entering `docker exec`, `ssh` or a child `zsh`
# makes Warp fall back to plain text mode. The hook below
# "warpifies" automatically, with no need to click the banner.
# Docs: https://docs.warp.dev/terminal/warpify/subshells
# ==========================================
if [[ "$TERM_PROGRAM" == "WarpTerminal" ]]; then
    printf '\eP$f{"hook": "SourcedRcFileForWarp", "value": { "shell": "zsh"}}\x9c'
fi

# ==========================================
# WARP - Local configuration directories
# themes:   ~/.warp/themes
# workflows: ~/.warp/workflows (or .warp/workflows at the repo root)
# ==========================================
export WARP_HOME="$HOME/.warp"
export WARP_THEMES_DIR="$WARP_HOME/themes"
export WARP_WORKFLOWS_DIR="$WARP_HOME/workflows"

# ==========================================
# WARP - Preferences (macOS uses `defaults`, not JSON)
# E.g.: disable in-band commands in remote sessions
#   defaults write dev.warp.Warp-Stable DisableInBandCommands -string true
# On Linux the file is ~/.config/warp-terminal/user_preferences.json
# ==========================================
alias warp-prefs-read='defaults read dev.warp.Warp-Stable'
alias warp-prefs-dir='open "$WARP_HOME"'

# ==========================================
# WARP - Version workflows and themes in dotfiles
# Creates symlinks from ~/.warp/{workflows,themes} to the repository,
# so your YAML workflows go into git along with everything else.
# Usage: warp-link-dotfiles
# ==========================================
warp-link-dotfiles() {
    local src_workflows="$DOTFILES/warp/workflows"
    local src_themes="$DOTFILES/warp/themes"

    mkdir -p "$src_workflows" "$src_themes" "$WARP_HOME"

    local pair src dest
    for pair in "$src_workflows:$WARP_WORKFLOWS_DIR" "$src_themes:$WARP_THEMES_DIR"; do
        src="${pair%%:*}"
        dest="${pair##*:}"

        if [[ -L "$dest" ]]; then
            echo "• already linked: $dest"
        elif [[ -d "$dest" ]]; then
            echo "⚠️  $dest exists as a real folder. Move its contents to $src and run again."
        else
            ln -s "$src" "$dest" && echo "✓ $dest -> $src"
        fi
    done
}

# ==========================================
# WARP - Community themes
# https://github.com/warpdotdev/themes
# Usage: warp-install-themes
# ==========================================
warp-install-themes() {
    local tmp
    tmp=$(mktemp -d) || return 1
    mkdir -p "$WARP_THEMES_DIR"
    git clone --depth 1 https://github.com/warpdotdev/themes "$tmp/themes" &&
        cp -R "$tmp/themes"/*/*.yaml "$WARP_THEMES_DIR"/ 2>/dev/null
    rm -rf "$tmp"
    echo "✓ Themes copied to $WARP_THEMES_DIR (Settings > Appearance > Themes)"
}

# ==========================================
# WARP - New YAML workflow
# Workflows are parameterized, searchable aliases
# (Ctrl-Shift-R). A good home for the long aliases from this repo.
# Usage: warp-new-workflow deploy-hermes
# ==========================================
warp-new-workflow() {
    local name="$1"
    [[ -z "$name" ]] && { echo "Usage: warp-new-workflow <name>"; return 1; }

    local dir="${WARP_WORKFLOWS_DIR}"
    mkdir -p "$dir"
    local file="$dir/${name}.yaml"

    cat >"$file" <<EOF
---
name: ${name}
command: |-
  echo "{{input}}"
tags:
  - dotfiles
description: Describe what this workflow does
arguments:
  - name: input
    description: Input value
    default_value: ""
EOF

    "$EDITOR" "$file"
}

# ==========================================
# WARP - Shell behavior inside Warp
# Warp already has its own autocomplete, history and suggestions,
# so autosuggestion/syntax-highlight plugins only cost startup
# time and clash with the input editor.
# ==========================================
if [[ "$TERM_PROGRAM" == "WarpTerminal" ]]; then
    export DOTFILES_SKIP_ZSH_AUTOSUGGESTIONS=1
    export DOTFILES_SKIP_ZSH_SYNTAX_HIGHLIGHTING=1
fi

# ==========================================
# WARP - Prompt
# starship stays active in Warp by default (see .bootstrap).
# Requires Settings > Appearance > Input > Input Type > Shell (PS1)
# (or "Honor user's custom prompt (PS1)" in Settings > Features).
# To use Warp's native prompt (context chips):
#   export DOTFILES_STARSHIP_IN_WARP=0 in ~/.sensitive_variables
# Note: iTerm2's shell integration breaks the custom prompt in Warp.
# ==========================================

# ==========================================
# WARP - SSH as a subshell
# The legacy SSH wrapper doesn't support tmux. The official alternative:
# Settings > Warpify > Subshells > Added commands -> add `command ssh`
# and connect with: command ssh user@server
# ==========================================
alias ssh-warp='command ssh'

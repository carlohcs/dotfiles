#!/usr/bin/env zsh

# ==========================================
# BOOTSTRAP - Tooling initialization
# Everything that needs `eval`, `source` or
# depends on a binary already present in $PATH.
# Loaded AFTER .exports.
# ==========================================

# ==========================================
# FAST SHELL - Automated terminal detection
# VS Code tasks, CI and non-interactive shells don't need
# a fancy prompt or heavy plugins.
# Unlike the old version, we do NOT abort the whole file:
# version managers still load, otherwise `node`/`python`
# disappear inside VS Code.
# ==========================================
if [[ -n "$VSCODE_GIT_IPC_HANDLE" ]] || [[ "$TERM_PROGRAM" == "vscode" ]] || [[ -n "$CI" ]]; then
    export DOTFILES_FAST_SHELL=1
    export DISABLE_AUTO_TITLE="true"
fi

# ==========================================
# ASDF - https://github.com/asdf-vm/asdf
# Multi-language version manager
# ==========================================
if [[ -f /opt/homebrew/opt/asdf/libexec/asdf.sh ]]; then
    source /opt/homebrew/opt/asdf/libexec/asdf.sh
fi

# ==========================================
# PYENV - https://github.com/pyenv/pyenv
# Python version manager (used by headroom)
# ==========================================
if command -v pyenv >/dev/null 2>&1; then
    eval "$(pyenv init --path)"
    eval "$(pyenv init -)"
fi

# ==========================================
# GOOGLE CLOUD SDK - gcloud CLI
# Completion is heavy; skipped in FAST SHELL.
# disabled by now
# ==========================================
# if [[ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]]; then
#     source "$HOME/google-cloud-sdk/path.zsh.inc"
# fi

# if [[ "$DOTFILES_FAST_SHELL" != "1" ]] && [[ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]]; then
#     source "$HOME/google-cloud-sdk/completion.zsh.inc"
# fi

# ==========================================
# BUN - Completions
# ==========================================
[[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"

# ==========================================
# SSH AGENT - Loads keys from Keychain
# `ssh-add -A` has been deprecated on modern macOS.
# ==========================================
if [[ "$DOTFILES_FAST_SHELL" != "1" ]] && command -v ssh-add >/dev/null 2>&1; then
    ssh-add --apple-load-keychain 2>/dev/null || ssh-add -A 2>/dev/null
fi

# ==========================================
# STARSHIP - https://github.com/starship/starship
# Prompt. Also active in Warp (requires the "Shell (PS1)" input type).
# To go back to Warp's native prompt: DOTFILES_STARSHIP_IN_WARP=0
# in ~/.sensitive_variables (loaded before this file).
# ==========================================
if [[ "$DOTFILES_FAST_SHELL" == "1" ]]; then
    export STARSHIP_SHELL=""
elif command -v starship >/dev/null 2>&1; then
    if [[ "$TERM_PROGRAM" != "WarpTerminal" ]] || [[ "${DOTFILES_STARSHIP_IN_WARP:-1}" == "1" ]]; then
        eval "$(starship init zsh)"
        # Warp + zsh: restores the extra line after starship's prompt
        [[ "$TERM_PROGRAM" == "WarpTerminal" ]] && PROMPT="${PROMPT}"$'\n'
    fi
fi

# ==========================================
# LOCAL AI INTEGRATIONS - deepseek / qwen-mlx
# This repository's own scripts (`ai/tools`).
# ==========================================
[[ -f "$REPOSITORY_HOME/ai/tools/deepseek-local-setup/shell/deepseek-ai.sh" ]] &&
    source "$REPOSITORY_HOME/ai/tools/deepseek-local-setup/shell/deepseek-ai.sh"

[[ -f "$REPOSITORY_HOME/ai/tools/qwen-mlx-toolkit/shell/qwen-mlx.sh" ]] &&
    source "$REPOSITORY_HOME/ai/tools/qwen-mlx-toolkit/shell/qwen-mlx.sh"

# ==========================================
# FINAL PATH PRIORITY - pipx above the shims
# Must be the LAST PATH change: asdf and pyenv
# prepend their shims during the init above and would hijack
# binaries like `aws-okta-processor`.
# ==========================================
export PATH="$HOME/.local/bin:$PATH"

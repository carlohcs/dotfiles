#!/usr/bin/env zsh

# ==========================================
# BOOTSTRAP - Inicialização de ferramentas
# Tudo que precisa rodar `eval`, `source` ou
# depende de binário já presente no $PATH.
# Carregado DEPOIS de .exports.
# ==========================================

# ==========================================
# FAST SHELL - Detecção de terminais automatizados
# VS Code tasks, CI e shells não interativos não precisam
# de prompt bonito nem de plugins pesados.
# Diferente da versão antiga, NÃO abortamos o arquivo inteiro:
# version managers continuam carregando, senão `node`/`python`
# somem dentro do VS Code.
# ==========================================
if [[ -n "$VSCODE_GIT_IPC_HANDLE" ]] || [[ "$TERM_PROGRAM" == "vscode" ]] || [[ -n "$CI" ]]; then
    export DOTFILES_FAST_SHELL=1
    export DISABLE_AUTO_TITLE="true"
fi

# ==========================================
# ASDF - https://github.com/asdf-vm/asdf
# Version manager multi-linguagem
# ==========================================
if [[ -f /opt/homebrew/opt/asdf/libexec/asdf.sh ]]; then
    source /opt/homebrew/opt/asdf/libexec/asdf.sh
fi

# ==========================================
# PYENV - https://github.com/pyenv/pyenv
# Version manager de Python (usado pelo headroom)
# ==========================================
if command -v pyenv >/dev/null 2>&1; then
    eval "$(pyenv init --path)"
    eval "$(pyenv init -)"
fi

# ==========================================
# CONDA - Distribuição Anaconda
# Bloco gerenciado por `conda init`. Carregado sob demanda
# em FAST SHELL para não pesar na abertura do terminal.
# Rode `conda-activate` quando precisar.
# disabled by now
# ==========================================
# _load_conda() {
#     local __conda_setup
#     __conda_setup="$('/opt/anaconda3/bin/conda' 'shell.zsh' 'hook' 2>/dev/null)"
#     if [[ $? -eq 0 ]]; then
#         eval "$__conda_setup"
#     elif [[ -f "/opt/anaconda3/etc/profile.d/conda.sh" ]]; then
#         source "/opt/anaconda3/etc/profile.d/conda.sh"
#     else
#         path_prepend "/opt/anaconda3/bin"
#     fi
#     unset __conda_setup
# }

# conda-activate() {
#     _load_conda
#     [[ -n "$1" ]] && conda activate "$1"
# }

# if [[ "$DOTFILES_FAST_SHELL" != "1" ]] && [[ -d /opt/anaconda3 ]]; then
#     _load_conda
# fi

# ==========================================
# GOOGLE CLOUD SDK - gcloud CLI
# O completion é pesado; pulado em FAST SHELL.
# disabled by now
# ==========================================
# if [[ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]]; then
#     source "$HOME/google-cloud-sdk/path.zsh.inc"
# fi

# if [[ "$DOTFILES_FAST_SHELL" != "1" ]] && [[ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]]; then
#     source "$HOME/google-cloud-sdk/completion.zsh.inc"
# fi

# ==========================================
# BUN - Completions
# ==========================================
[[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"

# ==========================================
# SSH AGENT - Carrega chaves do Keychain
# `ssh-add -A` foi descontinuado no macOS moderno.
# ==========================================
if [[ "$DOTFILES_FAST_SHELL" != "1" ]] && command -v ssh-add >/dev/null 2>&1; then
    ssh-add --apple-load-keychain 2>/dev/null || ssh-add -A 2>/dev/null
fi

# ==========================================
# STARSHIP - https://github.com/starship/starship
# Prompt. Ativo também no Warp (exige o input type "Shell (PS1)").
# Para voltar ao prompt nativo do Warp: DOTFILES_STARSHIP_IN_WARP=0
# no ~/.sensitive_variables (carregado antes deste arquivo).
# ==========================================
if [[ "$DOTFILES_FAST_SHELL" == "1" ]]; then
    export STARSHIP_SHELL=""
elif command -v starship >/dev/null 2>&1; then
    if [[ "$TERM_PROGRAM" != "WarpTerminal" ]] || [[ "${DOTFILES_STARSHIP_IN_WARP:-1}" == "1" ]]; then
        eval "$(starship init zsh)"
        # Warp + zsh: restaura a linha extra após o prompt do starship
        [[ "$TERM_PROGRAM" == "WarpTerminal" ]] && PROMPT="${PROMPT}"$'\n'
    fi
fi

# ==========================================
# INTEGRAÇÕES DE IA LOCAIS - deepseek / qwen-mlx
# Scripts próprios do repositório `ai/tools`.
# ==========================================
[[ -f "$REPOSITORY_HOME/ai/tools/deepseek-local-setup/shell/deepseek-ai.sh" ]] &&
    source "$REPOSITORY_HOME/ai/tools/deepseek-local-setup/shell/deepseek-ai.sh"

[[ -f "$REPOSITORY_HOME/ai/tools/qwen-mlx-toolkit/shell/qwen-mlx.sh" ]] &&
    source "$REPOSITORY_HOME/ai/tools/qwen-mlx-toolkit/shell/qwen-mlx.sh"

# ==========================================
# PRIORIDADE FINAL DE PATH - pipx acima dos shims
# Precisa ser a ÚLTIMA alteração de PATH: asdf e pyenv
# prependam seus shims no init acima e sequestrariam
# binários como `aws-okta-processor`.
# ==========================================
export PATH="$HOME/.local/bin:$PATH"

#!/usr/bin/env zsh

# ==========================================
# EXPORTS - Environment variables and PATH
# Loaded FIRST. Nothing here can depend
# on binaries installed by version managers.
# Load order: exports -> bootstrap -> aliases
#             -> functions -> navigation
#             -> warp-config -> extras -> extra
# ==========================================

# ==========================================
# PATH HELPERS - Avoid duplication in $PATH
# Use path_prepend for high priority,
# path_append for low priority.
# ==========================================
path_prepend() {
    local dir="$1"
    [[ -d "$dir" ]] || return 0
    case ":$PATH:" in
        *":$dir:"*) ;;
        *) export PATH="$dir:$PATH" ;;
    esac
}

path_append() {
    local dir="$1"
    [[ -d "$dir" ]] || return 0
    case ":$PATH:" in
        *":$dir:"*) ;;
        *) export PATH="$PATH:$dir" ;;
    esac
}

# ==========================================
# DOTFILES - Root of the configuration repository
# Every other file is resolved from here.
# ==========================================
export DOTFILES="${DOTFILES:-$HOME/Documents/repository/dotfiles}"
export REPOSITORY_HOME="${REPOSITORY_HOME:-$HOME/Documents/repository}"

# ==========================================
# EDITOR - Default system editor
# Note: `alias vim=nvim` does NOT affect $EDITOR,
# because aliases aren't expanded by other programs.
# That's why we point straight at the real binary.
# ==========================================
if command -v nvim >/dev/null 2>&1; then
    export EDITOR="nvim"
    export VISUAL="nvim"
else
    export EDITOR="vim"
    export VISUAL="vim"
fi

# ==========================================
# LOCALE & PAGER - Language and paging
# ==========================================
# LANG is enough; LC_ALL overrides ALL LC_* categories at once
# and tends to silently break local settings (dates, numbers).
export LANG="${LANG:-en_US.UTF-8}"
export LESS="-R"                       # keep colors in less
export MANPAGER="${MANPAGER:-less -R}" # swap for 'bat' if you want colored man pages

# ==========================================
# HISTORY - zsh history behavior
# ==========================================
export HISTSIZE=100000
export SAVEHIST=100000
export HISTFILE="$HOME/.zsh_history"

# ==========================================
# BASE PATH - Personal binary directories
# ==========================================
path_prepend "$HOME/bin"
path_prepend "$HOME/.local/bin" # pipx, fsearch, create-global-link

# ==========================================
# HOMEBREW - macOS packages (Apple Silicon)
# ==========================================
path_prepend "/opt/homebrew/bin"
path_prepend "/opt/homebrew/sbin"
path_prepend "/opt/homebrew/opt/postgresql@15/bin"

# ==========================================
# NODE / PNPM / BUN - JS runtimes and package managers
# ==========================================
export PNPM_HOME="$HOME/Library/pnpm"
path_prepend "$PNPM_HOME"

export BUN_INSTALL="$HOME/.bun"
path_prepend "$BUN_INSTALL/bin"

# ==========================================
# PROTO - https://github.com/moonrepo/proto
# Multi-language manager (shims)
# ==========================================
export PROTO_HOME="$HOME/.proto"
path_prepend "$PROTO_HOME/shims"
path_prepend "$PROTO_HOME/bin"

# ==========================================
# RUST / CARGO - Rust toolchain
# Also needed to compile fsearch from source.
# ==========================================
path_prepend "$HOME/.cargo/bin"

# ==========================================
# VCPKG - https://github.com/allenk/GeminiWatermarkTool
# C/C++ dependency manager
# ==========================================
export VCPKG_ROOT="$REPOSITORY_HOME/vcpkg"

# ==========================================
# DOCKER / COLIMA - Container runtime
# Points the Docker CLI at Colima's socket.
# ==========================================
export DOCKER_HOST="unix://${HOME}/.colima/default/docker.sock"
export DOCKER_CONTEXT="colima"

# ==========================================
# STARSHIP - https://github.com/starship/starship
# Prompt. Its init lives in .bootstrap (needs the binary in PATH).
# ==========================================
export STARSHIP_CONFIG="$DOTFILES/starship.toml"

# ==========================================
# HEADROOM - https://github.com/headroomlabs-ai/headroom
# Proxy/MCP that cuts 60-95% of tokens sent to agents.
# Two independent instances so personal and work sessions never
# share context/cache — each profile gets its own port, passed to
# `headroom wrap claude --port <n>` (the only thing the headroom
# binary actually reads; it has no HEADROOM_PROXY_CMD/URL env var).
# `run-ai` in .functions picks the right port via _run-ai-profile.
# ==========================================
export HEADROOM_PERSONAL_PORT="8787"
export HEADROOM_WORK_PORT="8788"

# ==========================================
# CCSTATUSLINE - Claude Code status line
# ==========================================
export CCSTATUSLINE_CONFIG="$DOTFILES/ai/tools/ccstatusline-config.json"

# ==========================================
# LM STUDIO - Local models CLI
# ==========================================
path_append "$HOME/.lmstudio/bin"

# ==========================================
# FSEARCH - https://github.com/noahdunnagan/fsearch
# Data/index directory (macOS).
# Usage functions live in .navigation
# ==========================================
export FSEARCH_HOME="$HOME/Library/Application Support/FSearch"
export FSEARCH_SOCKET="$FSEARCH_HOME/fsearch.sock"
export FSEARCH_SKIP_FILE="$FSEARCH_HOME/content-skip.txt"

# ==========================================
# FZF - https://github.com/junegunn/fzf
# Global defaults. Integration and keybindings in .navigation
# ==========================================
export FZF_DEFAULT_OPTS="
  --height=60%
  --layout=reverse
  --border=rounded
  --info=inline
  --cycle
  --bind=ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down
  --bind=ctrl-y:accept
"

# ==========================================
# CORPORATE WORKSPACES - GoDaddy / Poynt
# Real values should come from `.extra` (outside git).
# We only set fallbacks here so aliases don't break.
# ==========================================
: "${GODADDY_WORKSPACE:=$HOME/Documents/godaddy}"
: "${GODADDY_POYNT:=$GODADDY_WORKSPACE/poynt}"
: "${POYNT_KEYS:=$GODADDY_WORKSPACE/keys}"
export GODADDY_WORKSPACE GODADDY_POYNT POYNT_KEYS

# ==========================================
# SCREENSHOTS - Destination for screenshots
# ==========================================
export CAPTURE_FOLDER="$HOME/Desktop"

# ==========================================
# FAST SHELL - Lightweight mode for automated terminals
# When =1, .bootstrap skips the heavy prompt/plugins.
# Auto-detected in .bootstrap (VS Code, CI, etc).
# ==========================================
export DOTFILES_FAST_SHELL="${DOTFILES_FAST_SHELL:-0}"

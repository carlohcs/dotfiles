#!/usr/bin/env zsh

# ==========================================
# FUNCTIONS - Shell functions
# Everything that needs arguments, logic or
# multiple lines. Aliases live in `.aliases`.
# ==========================================

# ==========================================
# AWS - Full session cleanup
# Removes temporary tokens, SSO/boto caches and
# environment variables, preserving personal credentials.
# Backs up before any destructive change.
# ==========================================
clean-aws-current-session() {
    unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
    unset AWS_PROFILE AWS_DEFAULT_PROFILE AWS_REGION AWS_DEFAULT_REGION

    rm -rf ~/.aws/sso/cache/
    rm -rf ~/.aws/cli/cache/
    rm -rf ~/.aws-okta-processor/

    if [[ -f ~/.aws/credentials ]]; then
        cp ~/.aws/credentials ~/.aws/credentials.backup.$(date +%Y%m%d_%H%M%S)
        sed -i.bak '/aws_session_token/d; /aws_access_key_id.*ASIA/d; /aws_secret_access_key.*[A-Za-z0-9+/]\{32,\}/d' ~/.aws/credentials 2>/dev/null
        echo "✓ Session tokens removed from ~/.aws/credentials (personal credentials preserved)"
    fi

    if [[ -d ~/.aws/boto ]]; then
        cp -r ~/.aws/boto ~/.aws/boto.backup.$(date +%Y%m%d_%H%M%S)
        rm -rf ~/.aws/boto/cache/ 2>/dev/null || true
        echo "✓ boto cache cleared (backup created)"
    fi

    if [[ -f ~/.aws/config ]]; then
        sed -i.bak '/aws_session_token/d; /aws_access_key_id.*ASIA/d; /aws_secret_access_key.*temp/d' ~/.aws/config 2>/dev/null
        echo "✓ Session tokens removed from ~/.aws/config"
    fi

    aws sso logout 2>/dev/null || true
    rm -rf /tmp/aws-* 2>/dev/null || true
    rm -rf ~/Library/Caches/aws-cli/ 2>/dev/null || true
    unset AWS_SHARED_CREDENTIALS_FILE AWS_CONFIG_FILE

    echo "✓ AWS session fully cleaned"
    echo "Note: you may need to restart the terminal for a full cleanup"
}

# ==========================================
# AWS - Restore the latest backup
# Reverts credentials and boto cache to the previous state.
# ==========================================
restore-aws-credentials() {
    local latest_backup
    latest_backup=$(ls -t ~/.aws/credentials.backup.* 2>/dev/null | head -n 1)

    if [[ -n "$latest_backup" ]]; then
        cp "$latest_backup" ~/.aws/credentials
        echo "✓ Credentials restored from: $(basename $latest_backup)"
        echo "Available backups:"
        ls -la ~/.aws/credentials.backup.* 2>/dev/null | awk '{print "  " $9 " (" $6 " " $7 " " $8 ")"}'
    else
        echo "✗ No credential backup found"
    fi

    local latest_boto_backup
    latest_boto_backup=$(ls -td ~/.aws/boto.backup.* 2>/dev/null | head -n 1)
    if [[ -n "$latest_boto_backup" ]]; then
        rm -rf ~/.aws/boto 2>/dev/null || true
        cp -r "$latest_boto_backup" ~/.aws/boto
        echo "✓ boto cache restored from: $(basename $latest_boto_backup)"
    else
        echo "  No boto cache backup found"
    fi
}

# ==========================================
# AWS - Quick cleanup (no backup)
# Only removes temporary tokens from files and environment.
# ==========================================
clean-aws-tokens-only() {
    echo "🧹 Cleaning only AWS session tokens..."

    if [[ -f ~/.aws/credentials ]]; then
        sed -i.tmp '/aws_session_token/d; /aws_access_key_id.*ASIA/d' ~/.aws/credentials 2>/dev/null
        rm -f ~/.aws/credentials.tmp 2>/dev/null
        echo "✓ Tokens removed from credentials"
    fi

    if [[ -f ~/.aws/config ]]; then
        sed -i.tmp '/aws_session_token/d; /aws_access_key_id.*ASIA/d' ~/.aws/config 2>/dev/null
        rm -f ~/.aws/config.tmp 2>/dev/null
        echo "✓ Tokens removed from config"
    fi

    unset AWS_SESSION_TOKEN AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
    echo "✓ Session tokens cleaned (personal credentials preserved)"
}

# ==========================================
# AWS - Current session diagnostics
# Shows variables, profiles, active session and backups.
# ==========================================
check-aws-session() {
    echo "=== AWS Session Status ==="

    printf "\n"; echo "🔧 Environment variables:"
    env | grep -E "^AWS_" | sort || echo "  No AWS variable defined"

    printf "\n"; echo "📁 Credentials file:"
    if [[ -f ~/.aws/credentials ]]; then
        echo "  ✓ ~/.aws/credentials exists"
        echo "  Profiles:"
        grep '^\[' ~/.aws/credentials | sed 's/\[//g;s/\]//g;s/^/    /'
    else
        echo "  ✗ ~/.aws/credentials not found"
    fi

    printf "\n"; echo "⚙️  Config file:"
    if [[ -f ~/.aws/config ]]; then
        echo "  ✓ ~/.aws/config exists"
    else
        echo "  ✗ ~/.aws/config not found"
    fi

    printf "\n"; echo "🔐 Current session:"
    aws sts get-caller-identity 2>/dev/null && echo "  ✓ Active AWS session" || echo "  ✗ No active AWS session"

    printf "\n"; echo "💾 Available backups:"
    if ls ~/.aws/credentials.backup.* >/dev/null 2>&1; then
        ls -la ~/.aws/credentials.backup.* | awk '{print "  " $9 " (" $6 " " $7 " " $8 ")"}'
    else
        echo "  No backup found"
    fi

    printf "\n"; echo "==========================="
}

# ==========================================
# AWS - CloudFormation
# Lists active stacks related to cost-of-goods.
# ==========================================
aws-list-stacks() {
    aws cloudformation list-stacks \
        --region us-west-2 \
        --stack-status-filter CREATE_COMPLETE UPDATE_COMPLETE UPDATE_COMPLETE_CLEANUP_IN_PROGRESS \
        --query 'StackSummaries[?contains(StackName, `cost-of-goods`)].{Name:StackName,Status:StackStatus,LastUpdated:LastUpdatedTime}' \
        --output table
}

# ==========================================
# KUBERNETES - Hermes pods (gdp namespace)
# ==========================================
get-hermes-pods() {
    kubectl get pods --namespace gdp | grep 'hermes'
}

connect-hermes-pod() {
    kubectl exec -it --namespace gdp \
        "$(kubectl get pods --namespace gdp | grep 'hermes' | awk '{print $1}' | head -n 1)" -- /bin/bash
}

# ==========================================
# JAVA - Switch JDK in the current session
# Usage: switch-java 21.0.2  |  switch-java-latest  |  switch-java-17
# ==========================================
switch-java() {
    local version="$1"
    if [[ -z "$version" ]]; then
        echo "Usage: switch-java <version>   (see with: get-java-versions)"
        return 1
    fi
    export JAVA_HOME="$(/usr/libexec/java_home -v "$version")" && echo "JAVA_HOME=$JAVA_HOME"
}

switch-java-latest() { switch-java 21.0.2; }
switch-java-17() { switch-java 17.0.10; }

# ==========================================
# COLIMA - Setup and lifecycle
# vz + Rosetta + virtiofs is the fastest combination
# on Apple Silicon for x86 images.
# ==========================================
colima-setup() {
    colima start \
        --vm-type=vz \
        --vz-rosetta \
        --cpu 6 \
        --memory 14 \
        --disk 100 \
        --mount-type=virtiofs \
        --save-config
}

crestart() {
    colima stop && colima start
}

# ==========================================
# AI AGENTS - Credential profile by directory
# Prints `work` if any component of $PWD is `Poynt`
# (case-insensitive) and `personal` if it's `repository` or
# any other path. Poynt takes priority, since it can
# be nested inside `repository`.
# ==========================================
_run-ai-profile() {
    local -a parts=("${(@s:/:)${PWD:l}}")
    if (( ${parts[(Ie)poynt]} )); then
        echo work
    else
        echo personal
    fi
}

# ==========================================
# AI AGENTS - headroom proxy pair by profile
# Each profile gets its own headroom instance/port (see
# HEADROOM_PERSONAL_PORT / HEADROOM_WORK_PORT in .exports) so their
# context/cache never mix. `headroom wrap` only reads the real
# `--port` flag, so this just resolves the number.
# The split is load-bearing: the proxy reads ANTHROPIC_TARGET_API_URL
# once at startup, so a single shared instance would pin both
# profiles to whichever upstream happened to launch it (personal
# traffic hitting the company gateway, or work traffic hitting
# api.anthropic.com).
# Usage: _headroom-proxy-port work|personal
# ==========================================
_headroom-proxy-port() {
    [[ "$1" == "work" ]] && echo "${HEADROOM_WORK_PORT:-8788}" || echo "${HEADROOM_PERSONAL_PORT:-8787}"
}

# ==========================================
# AI AGENTS - warn about a cross-profile proxy
# A headroom instance bakes in its upstream at startup, so reusing
# one that the other profile started routes to the wrong API and
# shows up as a 401/ECONNREFUSED mid-session. Warns if the port in
# use was not launched from this profile's directory kind.
# Usage: _headroom-proxy-check work|personal <port>
# ==========================================
_headroom-proxy-check() {
    local profile="$1" port="$2" owner_pwd
    command -v lsof >/dev/null 2>&1 || return 0

    # Oldest listener on the port is the proxy parent.
    local pid
    pid="$(lsof -nP -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null | head -1)"
    [[ -z "$pid" ]] && return 0

    owner_pwd="$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)"
    [[ -z "$owner_pwd" ]] && return 0

    local owner_profile
    if [[ "${owner_pwd:l}" == */poynt/* || "${owner_pwd:l}" == */poynt ]]; then
        owner_profile=work
    else
        owner_profile=personal
    fi

    if [[ "$owner_profile" != "$profile" ]]; then
        echo "⚠️  headroom on port $port was started from a $owner_profile dir ($owner_pwd)."
        echo "    Its upstream is fixed at startup, so this $profile session may hit the wrong API."
        echo "    Fix: kill $pid   # then rerun run-ai claude"
    fi
}

# ==========================================
# AI AGENTS - headroom wrapper
# Usage: run-ai claude [args] | run-ai claude-local | run-ai <agent>
# ==========================================
run-ai() {
    local agent="$1"
    local headroom_bin
    local profile
    shift || true

    if [[ -z "$agent" ]]; then
        echo "Usage: run-ai <agent> [args...]"
        return 1
    fi

    headroom_bin="$(command -v headroom 2>/dev/null || true)"
    if [[ -z "$headroom_bin" ]] && command -v pyenv >/dev/null 2>&1; then
        headroom_bin="$(pyenv which headroom 2>/dev/null || true)"
    fi

    profile="$(_run-ai-profile)"

    # Personal claude is the only path that still works without headroom
    # (subscription login goes straight to the API), so it's exempt from
    # the hard requirement below.
    if [[ -z "$headroom_bin" ]] && [[ "$agent" != "claude-local" ]] &&
        ! { [[ "$agent" == "claude" ]] && [[ "$profile" == "personal" ]]; }; then
        echo "headroom not found in PATH/pyenv"
        return 127
    fi

    case "$agent" in
    claude)
        pyenv local 3.14.6 # headroom requires 3.14.6
        case "$profile" in
        work)
            echo "🏢 run-ai: company credentials (Poynt)"
            # ANTHROPIC_AUTH_TOKEN (token/gateway auth) and ANTHROPIC_API_KEY
            # are mutually exclusive for Claude Code; headroom refuses to
            # start if both are set (e.g. a stray export in .extra/settings).
            _headroom-proxy-check work "$(_headroom-proxy-port work)"
            env -u ANTHROPIC_API_KEY \
                ANTHROPIC_TARGET_API_URL="${ANTHROPIC_BASE_URL}" \
                ANTHROPIC_AUTH_TOKEN="${ANTHROPIC_AUTH_TOKEN:-$GOCODE_API_TOKEN}" \
                command "$headroom_bin" wrap claude --port "$(_headroom-proxy-port work)" -- "$@"
            ;;
        *)
            echo "👤 run-ai: personal credentials (subscription login)"
            # Subscription login (/login) through headroom: the proxy
            # forwards the OAuth bearer token upstream and classifies the
            # session as AuthMode.SUBSCRIPTION from the claude-cli/ UA, which
            # keeps compression conservative (live zone only) to protect the
            # cache prefix. Must NOT inherit the work gateway: ANTHROPIC_BASE_URL
            # is the company endpoint and ANTHROPIC_TARGET_API_URL would point
            # headroom at it, so both are cleared and headroom defaults to the
            # real Anthropic API.
            if [[ -n "$headroom_bin" ]]; then
                _headroom-proxy-check personal "$(_headroom-proxy-port personal)"
                env -u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_API_KEY \
                    -u ANTHROPIC_TARGET_API_URL -u ANTHROPIC_CUSTOM_HEADERS \
                    "$headroom_bin" wrap claude --port "$(_headroom-proxy-port personal)" -- "$@"
            else
                env -u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_API_KEY \
                    -u ANTHROPIC_TARGET_API_URL -u ANTHROPIC_CUSTOM_HEADERS \
                    claude "$@"
            fi
            ;;
        esac
        ;;
    claude-local)
        pyenv local 3.14.6

        # Starts fcc-server if it isn't already responding
        if ! curl -s http://127.0.0.1:8082 >/dev/null; then
            echo "🚀 Starting fcc-server in the background..."
            fcc-server >/tmp/fcc-server.log 2>&1 &
            sleep 2

            if command -v open >/dev/null; then
                open "http://127.0.0.1:8082/admin"
            elif command -v xdg-open >/dev/null; then
                xdg-open "http://127.0.0.1:8082/admin"
            fi
        else
            echo "✅ fcc-server is already running."
        fi

        # Calls claude directly (bypassing headroom)
        ANTHROPIC_BASE_URL="http://127.0.0.1:8082" \
            ANTHROPIC_AUTH_TOKEN="freecc" \
            command claude "$@"
        ;;
    *)
        command "$headroom_bin" wrap "$agent" --port "$(_headroom-proxy-port "$profile")" -- "$@"
        ;;
    esac
}

# ==========================================
# AI AGENTS - Claude without headroom (no proxy)
# Usage: claude-no-compress [args]
# Same profile as run-ai (work/personal by $PWD), but calls
# claude directly, without going through headroom's proxy.
# ==========================================
claude-no-compress() {
    case "$(_run-ai-profile)" in
    work)
        echo "🏢 claude-no-compress: company credentials (no headroom)"
        ANTHROPIC_AUTH_TOKEN="${ANTHROPIC_AUTH_TOKEN:-$GOCODE_API_TOKEN}" \
            command claude "$@"
        ;;
    *)
        echo "👤 claude-no-compress: personal credentials (no headroom)"
        env -u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_API_KEY -u ANTHROPIC_TARGET_API_URL \
            command claude "$@"
        ;;
    esac
}

# ==========================================
# TELEGRAM - Test OpenClaw's bot
# ==========================================
test-telegram-bot() {
    local bot_token="${1:-$OPEN_CLAW_ASSISTANT_TELEGRAM_BOT_TOKEN}"

    if [[ -z "$bot_token" ]]; then
        echo "Usage: test-telegram-bot <bot-token>"
        return 1
    fi

    curl -s "https://api.telegram.org/bot${bot_token}/getMe"
}

# ==========================================
# ARCHITECTURE - x86 shell via Rosetta
# Useful for tools without a native arm64 build.
# ==========================================
run-terminal-x86() {
    arch -x86_64 zsh
}

# ==========================================
# FFMPEG - Video conversion
# https://unix.stackexchange.com/questions/28803
# h265 + crf 28 is the best size/quality tradeoff.
# ==========================================
convert-video() {
    local inputVideo="$1"
    ffmpeg -i "$inputVideo" -vcodec libx265 -crf 28 "$inputVideo.mp4"
}

convert-video-no-audio-removed-frames() {
    local inputVideo="$1"
    ffmpeg -i "$inputVideo" -vcodec libx265 -crf 28 -vf mpdecimate,setpts=N/FRAME_RATE/TB "$inputVideo.mp4"
}

convert-video-to-gif() {
    local inputVideo="$1"
    ffmpeg -i "$inputVideo" -vf "fps=60,scale=1046:-1:flags=lanczos,mpdecimate" -c:v gif "$inputVideo.gif"
}

convert-video-to-mp3() {
    local inputVideo="$1"
    local outputAudio="$2"
    ffmpeg -i "$inputVideo" -vn -acodec libmp3lame -q:a 2 "$outputAudio"
}

download-m3u8() {
    local inputM3u8="$1"
    local outputName="$2"
    ffmpeg -i "${inputM3u8}" -map p:1 -c:v h264_videotoolbox -b:v 2500k -vf scale=1280:-1 -c:a aac -strict -2 "${outputName}"
}

# ==========================================
# IMAGE - Conversion via sips (native macOS)
# Usage: convert-image photo.png 70
# ==========================================
convert-image() {
    local inputImage="$1"
    local quality="$2"
    sips -s format jpeg -s formatOptions "$quality" "$inputImage" --out ./converted-image.jpeg
}

# ==========================================
# PROCESSES - Kill whoever is holding a port
# ==========================================
kill-port() {
    local port="$1"

    if [[ -z "$port" ]]; then
        echo "Usage: kill-port <port>"
        return 1
    fi

    lsof -ti tcp:"$port" | xargs kill -9
}

# ==========================================
# FILES - Clipboard and backups
# ==========================================
copyfile() {
    if [[ -n "$1" ]] && [[ -f "$1" ]]; then
        pbcopy <"$1"
        return 0
    fi
    printf "File not found: %s\n" "$1"
    return 1
}

buf() {
    local filename="$1"
    local filetime
    filetime=$(date +%Y%m%d_%H%M%S)
    cp -a "$filename" "${filename}_${filetime}"
}

backup-folder() {
    if [[ -d "$1" ]]; then
        local foldername="$1"
        local foldertime
        foldertime=$(date +%Y%m%d_%H%M%S)
        cp -a "$foldername" "${foldername}_${foldertime}"
    else
        printf "Directory not found: %s\n" "$1"
    fi
}

# ==========================================
# GIT - Current repository URL
# Usage: gurl [remote]   (default: origin)
# ==========================================
gurl() (
    local remote remotename host user_repo

    remotename="${*:-origin}"
    remote="$(git remote -v | awk '/^'"${remotename}"'.*\(push\)$/ {print $2}')"
    [[ "${remote}" ]] || return
    host="$(echo "${remote}" | perl -pe 's/.*@//;s/:.*//')"
    user_repo="$(echo "${remote}" | perl -pe 's/.*://;s/\.git$//')"
    echo "https://${host}/${user_repo}"
)

# ==========================================
# MACOS - Screenshots and integrations
# ==========================================
if [[ "$OSTYPE" == darwin* ]]; then

    cap() {
        screencapture "${CAPTURE_FOLDER}/capture-$(date +%Y%m%d_%H%M%S).png"
    }

    capi() {
        screencapture -i "${CAPTURE_FOLDER}/capture-$(date +%Y%m%d_%H%M%S).png"
    }

    capiw() {
        screencapture -i -w "${CAPTURE_FOLDER}/capture-$(date +%Y%m%d_%H%M%S).png"
    }

    # Opens Finder in the given directory (default: current)
    f() {
        open -a "Finder" "${1:-.}"
    }

    intellij() {
        open -na "IntelliJ IDEA.app" --args "$@"
    }

    # ==========================================
    # MACOS - Global link in ~/.local/bin
    # Usage: create-global-link ./script.sh [name]
    # ==========================================
    create-global-link() {
        if [[ -z "$1" ]]; then
            echo "Usage: create-global-link <file-path> [link-name]"
            return 1
        fi

        local target_file
        target_file=$(realpath "$1")

        local link_name=${2:-$(basename "$target_file")}
        local bin_dir="$HOME/.local/bin"

        mkdir -p "$bin_dir"
        chmod +x "$target_file"
        ln -sf "$target_file" "$bin_dir/$link_name"

        echo "✅ Shortcut created: $link_name -> $target_file"
    }
fi

# ==========================================
# NERD FONT - https://www.nerdfonts.com
# Installs the font that `eza --icons` and starship need
# to draw icons (without it you get gaps or boxes).
# Usage: nerdfont-setup            -> MesloLGS Nerd Font
#        nerdfont-setup <cask>     -> another, e.g. font-fira-code-nerd-font
# Warp can't be configured from here: after installing,
# select the font manually (the function prints the path).
# ==========================================
nerdfont-setup() {
    local cask="${1:-font-meslo-lg-nerd-font}"

    command -v brew >/dev/null 2>&1 || { echo "❌ Homebrew not found"; return 1; }

    if brew list --cask "$cask" >/dev/null 2>&1; then
        echo "✓ $cask already installed"
    else
        echo "⬇️  Installing $cask..."
        brew install --cask "$cask" || return 1
    fi

    echo ""
    echo "To activate:"
    echo "  1. Warp > Settings > Appearance > Text > Terminal font"
    echo "     -> choose 'MesloLGS Nerd Font' (or the installed font)"
    echo "  2. Restart Warp if the font doesn't show up in the list"
    echo "  3. Open a new tab and test: ls"
    echo ""
    echo "Other terminals: VS Code -> terminal.integrated.fontFamily = 'MesloLGS Nerd Font'"
    echo "                  iTerm2  -> Settings > Profiles > Text > Font"
}

clean-aws-current-session() {
    # Unset environment variables
    unset AWS_ACCESS_KEY_ID
    unset AWS_SECRET_ACCESS_KEY
    unset AWS_SESSION_TOKEN
    unset AWS_PROFILE
    unset AWS_DEFAULT_PROFILE
    unset AWS_REGION
    unset AWS_DEFAULT_REGION

    # Remove SSO and CLI cache
    rm -rf ~/.aws/sso/cache/
    rm -rf ~/.aws/cli/cache/

    # Remove aws-okta-processor cache
    rm -rf ~/.aws-okta-processor/

    # Clean session tokens from credentials file while preserving personal credentials
    if [ -f ~/.aws/credentials ]; then
        # Create backup before cleaning
        cp ~/.aws/credentials ~/.aws/credentials.backup.$(date +%Y%m%d_%H%M%S)
        # Remove only session tokens and temporary credentials, keep personal credentials
        sed -i.bak '/aws_session_token/d; /aws_access_key_id.*ASIA/d; /aws_secret_access_key.*[A-Za-z0-9+/]\{32,\}/d' ~/.aws/credentials 2>/dev/null
        echo "✓ AWS session tokens removed from credentials (personal credentials preserved)"
    fi

    if [ -d ~/.aws/boto ]; then
        echo "  ✓ ~/.aws/boto directory exists"
        # Create backup before cleaning
        cp -r ~/.aws/boto ~/.aws/boto.backup.$(date +%Y%m%d_%H%M%S)
        rm -rf ~/.aws/boto/cache/ 2>/dev/null || true
        echo "  ✓ Boto cache cleared (backup created)"
    fi

    # Clear any session tokens from config file
    if [ -f ~/.aws/config ]; then
        # Remove any lines containing session tokens or temporary credentials
        sed -i.bak '/aws_session_token/d; /aws_access_key_id.*ASIA/d; /aws_secret_access_key.*temp/d' ~/.aws/config 2>/dev/null
        echo "✓ AWS session tokens removed from config"
    fi

    # Try to logout from SSO sessions
    aws sso logout 2>/dev/null || true

    # Clear any potential session files in temp directories
    rm -rf /tmp/aws-* 2>/dev/null || true
    rm -rf ~/Library/Caches/aws-cli/ 2>/dev/null || true

    # Clear Docker context if using AWS credentials there
    unset AWS_SHARED_CREDENTIALS_FILE
    unset AWS_CONFIG_FILE

    echo "✓ AWS Session Completely Cleaned"
    echo "✓ Personal credentials preserved (only session tokens removed)"
    echo "✓ Credentials backed up as safety measure"
    echo "Note: You may need to restart your terminal session for complete cleanup"
}

restore-aws-credentials() {
    local latest_backup=$(ls -t ~/.aws/credentials.backup.* 2>/dev/null | head -n 1)
    
    if [ -n "$latest_backup" ]; then
        cp "$latest_backup" ~/.aws/credentials
        echo "✓ AWS credentials restored from: $(basename $latest_backup)"
        echo "Available backups:"
        ls -la ~/.aws/credentials.backup.* 2>/dev/null | awk '{print "  " $9 " (" $6 " " $7 " " $8 ")"}'
    else
        echo "✗ No AWS credentials backup found"
    fi

    # Restore Boto Cache
    local latest_boto_backup=$(ls -td ~/.aws/boto.backup.* 2>/dev/null | head -n 1)
    if [ -n "$latest_boto_backup" ]; then
        rm -rf ~/.aws/boto 2>/dev/null || true
        cp -r "$latest_boto_backup" ~/.aws/boto
        echo "✓ Boto cache restored from: $(basename $latest_boto_backup)"
    else
        echo "  No Boto cache backup found"
    fi
}

clean-aws-tokens-only() {
    # Quick cleanup of session tokens without backup
    echo "🧹 Cleaning AWS session tokens only..."
    
    # Clean session tokens from credentials file
    if [ -f ~/.aws/credentials ]; then
        sed -i.tmp '/aws_session_token/d; /aws_access_key_id.*ASIA/d' ~/.aws/credentials 2>/dev/null
        rm -f ~/.aws/credentials.tmp 2>/dev/null
        echo "✓ Session tokens removed from credentials"
    fi

    # Clean session tokens from config file
    if [ -f ~/.aws/config ]; then
        sed -i.tmp '/aws_session_token/d; /aws_access_key_id.*ASIA/d' ~/.aws/config 2>/dev/null
        rm -f ~/.aws/config.tmp 2>/dev/null
        echo "✓ Session tokens removed from config"
    fi

    # Clear environment variables
    unset AWS_SESSION_TOKEN
    unset AWS_ACCESS_KEY_ID
    unset AWS_SECRET_ACCESS_KEY
    
    echo "✓ AWS session tokens cleaned (personal credentials preserved)"
}

check-aws-session() {
    echo "=== AWS Session Status ==="
    
    # Check environment variables
    echo "\n🔧 Environment Variables:"
    env | grep -E "^AWS_" | sort || echo "  No AWS environment variables set"
    
    # Check credentials file
    echo "\n📁 Credentials File:"
    if [ -f ~/.aws/credentials ]; then
        echo "  ✓ ~/.aws/credentials exists"
        echo "  Profiles:"
        grep '^\[' ~/.aws/credentials | sed 's/\[//g;s/\]//g;s/^/    /'
    else
        echo "  ✗ ~/.aws/credentials not found"
    fi
    
    # Check config file
    echo "\n⚙️  Config File:"
    if [ -f ~/.aws/config ]; then
        echo "  ✓ ~/.aws/config exists"
    else
        echo "  ✗ ~/.aws/config not found"
    fi
    
    # Check active session
    echo "\n🔐 Current Session:"
    aws sts get-caller-identity 2>/dev/null && echo "  ✓ Active AWS session found" || echo "  ✗ No active AWS session"
    
    # Check backups
    echo "\n💾 Available Backups:"
    local backups=$(ls ~/.aws/credentials.backup.* 2>/dev/null)
    if [ -n "$backups" ]; then
        ls -la ~/.aws/credentials.backup.* | awk '{print "  " $9 " (" $6 " " $7 " " $8 ")"}'
    else
        echo "  No credential backups found"
    fi
    
    echo "\n==========================="
}


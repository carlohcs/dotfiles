# alias run-claude="ANTHROPIC_BASE_URL=$ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN=$GOCODE_API_TOKEN ANTHROPIC_MODEL=$ANTHROPIC_MODEL claude"

# --- Colima & Docker Helpers ---

# Shortcuts for Docker and Colima commands
alias d='docker'
alias dc='docker-compose'
alias cstart='colima start'
alias cstop='colima stop'
alias cstat='colima status && docker ps'

colima-setup() {
    colima start --vm-type=vz --vz-rosetta --cpu 6 --memory 14 --disk 100 --mount-type=virtiofs --save-config
}

# Set Docker host to Colima's socket for seamless Docker CLI usage with Colima
export DOCKER_HOST="unix://${HOME}/.colima/default/docker.sock"
export DOCKER_CONTEXT="colima"

aws-list-stacks() {
 aws cloudformation list-stacks --region us-west-2 --stack-status-filter CREATE_COMPLETE UPDATE_COMPLETE UPDATE_COMPLETE_CLEANUP_IN_PROGRESS --query 'StackSummaries[?contains(StackName, `cost-of-goods`)].{Name:StackName,Status:StackStatus,LastUpdated:LastUpdatedTime}' --output table
}

# Function to restart Colima and ensure Docker CLI continues to work with the new socket
crestart() {
  colima stop && colima start
}

# [Headroom](https://github.com/headroomlabs-ai/headroom) - 60–95% fewer tokens · library · proxy · MCP · content-aware compressors · local-first · reversible
export HEADROOM_PROXY_CMD="headroom proxy --port 8787"
export HEADROOM_PROXY_URL="http://127.0.0.1:8787"

run-ai() {
    local agent="$1"
    local headroom_bin
    shift || true

    if [ -z "$agent" ]; then
        echo "Usage: run-ai <agent> [args...]"
        return 1
    fi

    headroom_bin="$(command -v headroom 2>/dev/null || true)"
    if [ -z "$headroom_bin" ] && command -v pyenv >/dev/null 2>&1; then
        headroom_bin="$(pyenv which headroom 2>/dev/null || true)"
    fi

    if [ -z "$headroom_bin" ]; then
        echo "headroom command not found in PATH/pyenv"
        return 127
    fi

    # ANTHROPIC_MODEL="${ANTHROPIC_MODEL}" \
    case "$agent" in
        claude)
            # ANTHROPIC_TARGET_API_URL tells the headroom proxy which upstream to forward to.
            # Without it, wrap defaults to api.anthropic.com — which rejects corporate tokens.
            ANTHROPIC_TARGET_API_URL="${ANTHROPIC_BASE_URL}" \
            ANTHROPIC_AUTH_TOKEN="${ANTHROPIC_AUTH_TOKEN:-$GOCODE_API_TOKEN}" \
            command "$headroom_bin" wrap claude -- "$@"
            ;;
        *)
            command "$headroom_bin" wrap "$agent" -- "$@"
            ;;
    esac
}

alias claude='run-ai claude'

# enable run terminal at x86 for specific applications
run-terminal-x86() {
    arch -x86_64 zsh
}

# Convert videos
# https://unix.stackexchange.com/questions/28803/how-can-i-reduce-a-videos-size-with-ffmpeg
convert-video() {
    local inputVideo=$1
    
    ffmpeg -i "$inputVideo" -vcodec libx265 -crf 28 "$inputVideo.mp4"
}

convert-video-no-audio-removed-frames() {
    local inputVideo=$1
    
    ffmpeg -i "$inputVideo" -vcodec libx265 -crf 28 -vf mpdecimate,setpts=N/FRAME_RATE/TB "$inputVideo.mp4"
}

convert-video-to-gif() {
    local inputVideo=$1
    
    ffmpeg -i "$inputVideo" -vf "fps=60,scale=1046:-1:flags=lanczos,mpdecimate" -c:v gif "$inputVideo.gif"
}

convert-video-to-mp3() {
    local inputVideo=$1
    local outputAudio=$2
    
    ffmpeg -i "$inputVideo" -vn -acodec libmp3lame -q:a 2 "$outputAudio"
}

convert-image() {
    local inputImage=$1
    local quality=$2
    
    sips -s format jpeg -s formatOptions "$quality" $inputImage --out ./converted-image.jpeg
}

download-m3u8() {
    local inputM3u8=$1
    local outputName=$2
    
    ffmpeg -i "${inputM3u8}" -map p:1 -c:v h264_videotoolbox -b:v 2500k -vf scale=1280:-1 -c:a aac -strict -2 "${outputName}"
}

kill-port() {
    local port=$1
    
    if [ -z "$port" ]; then
        echo "Usage: kill-port <port>"
        return 1
    fi
    
    lsof -ti tcp:"$port" | xargs kill -9
}

# Always print contents of directory when entering
cd() {
    builtin cd "$@" || return 1
    l
}

# Copy contents of a file to the clipboard
copyfile() (
    # ARGS: 1 (Required) - Path to file
    
    if [ -n "$1" ] && [ -f "$1" ]; then
        pbcopy <"${1}"
        return 0
    else
        printf "File not found: %s\n" "$1"
        return 1
    fi
)

# Backup file with time stamp
buf() {
    local filename
    local filetime
    
    filename="${1}"
    filetime=$(date +%Y%m%d_%H%M%S)
    cp -a "${filename}" "${filename}_${filetime}"
}

backup-folder() {
    # ARGS: 1 (Required) - Path to folder
    # DESC: Creates a backup of the specified folder with a timestamp.
    
    if [ -d "$1" ]; then
        local foldername
        local foldertime
        
        foldername="${1}"
        foldertime=$(date +%Y%m%d_%H%M%S)
        cp -a "${foldername}" "${foldername}_${foldertime}"
    else
        printf "Directory not found: %s\n" "$1"
    fi
}

# Prints URL of current git repository
gurl() (
    
    local remote remotename host user_repo
    
    remotename="${*:-origin}"
    remote="$(git remote -v | awk '/^'"${remotename}"'.*\(push\)$/ {print $2}')"
    [[ "${remote}" ]] || return
    host="$(echo "${remote}" | perl -pe 's/.*@//;s/:.*//')"
    user_repo="$(echo "${remote}" | perl -pe 's/.*://;s/\.git$//')"
    echo "https://${host}/${user_repo}"
)

# MacOS Specific Shortcuts
# ###########################

if [[ ${OSTYPE} == "darwin"* ]]; then # Only load these on a MacOS computer
    
    ## ALIASES ##
    alias cpwd='pwd | tr -d "\n" | pbcopy'                        # Copy the working path to clipboard
    alias cl="fc -e -|pbcopy"                                     # Copy output of last command to clipboard
    alias caff="caffeinate -ism"                                  # Run command without letting mac sleep
    alias cleanDS="find . -type f -name '*.DS_Store' -ls -delete" # Delete .DS_Store files on Macs
    alias showHidden='defaults write com.apple.finder AppleShowAllFiles TRUE'
    alias hideHidden='defaults write com.apple.finder AppleShowAllFiles FALSE'
    alias capc="screencapture -c"
    alias capic="screencapture -i -c"
    alias capiwc="screencapture -i -w -c"
    
    CAPTURE_FOLDER="${HOME}/Desktop"
    
    function cap() {
        # DESC: Capture the screen to the desktop
        screencapture "${CAPTURE_FOLDER}/capture-$(date +%Y%m%d_%H%M%S).png"
    }
    
    function capi() {
        # DESC: Capture the selected screen area to the desktop
        screencapture -i "${CAPTURE_FOLDER}/capture-$(date +%Y%m%d_%H%M%S).png"
    }
    
    function capiw() {
        # DESC: Capture the selected window to the desktop
        screencapture -i -w "${CAPTURE_FOLDER}/capture-$(date +%Y%m%d_%H%M%S).png"
    }
    
    # Open the finder to a specified path or to current directory.
    f() {
        # DESC:  Opens the Finder to specified directory. (Default is current oath)
        # ARGS:  $1 (optional): Path to open in finder
        # REQS:  MacOS
        # USAGE: f [path]
        open -a "Finder" "${1:-.}"
    }

    intellij() {
        open -na "IntelliJ IDEA.app" --args "$@"
    }
fi

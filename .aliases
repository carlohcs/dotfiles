#!/usr/bin/env zsh

# ==========================================
# ALIASES - Somente atalhos de uma linha
# Funções foram movidas para `.functions`
# Aliases de pasta foram movidos para `.navigation`
# (agora viram named directories + zoxide)
# ==========================================

# ==========================================
# NAVEGAÇÃO RELATIVA - Subir níveis de diretório
# Pular para pastas por nome agora é com zoxide (.navigation)
# ==========================================
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ~="cd ~"
alias -- -="cd -"

# ==========================================
# EDIÇÃO DE CONFIGURAÇÃO - Abrir dotfiles
# ==========================================
alias edit-dotfiles='code "$DOTFILES"'
alias edit-aliases='$EDITOR "$DOTFILES/.aliases"'
alias edit-functions='$EDITOR "$DOTFILES/.functions"'
alias edit-exports='$EDITOR "$DOTFILES/.exports"'
alias edit-navigation='$EDITOR "$DOTFILES/.navigation"'
alias edit-warp='$EDITOR "$DOTFILES/.warp-config"'
alias edit-zshrc='$EDITOR "$HOME/.zshrc"'
alias reload-shell='exec zsh'
alias update-bashrc='source ~/.zshrc' # mantido por memória muscular
alias edit-bashrc='edit-aliases'      # idem
alias edit-hosts='sudo $EDITOR /etc/hosts'

# ==========================================
# SHORTCUTS - Comandos de uso diário
# ==========================================
alias g="git"
alias vim="nvim"
alias vi="nvim"
alias cat="bat"

# ==========================================
# GREP - Saída sempre colorida
# `GREP_OPTIONS` foi descontinuado, por isso os aliases.
# ==========================================
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# ==========================================
# REDE - Descoberta de IPs
# ==========================================
alias ip="dig +short myip.opendns.com @resolver1.opendns.com"
alias localip="ipconfig getifaddr en0"
alias ips="ifconfig -a | grep -o 'inet6\? \(addr:\)\?\s\?\(\(\([0-9]\+\.\)\{3\}[0-9]\+\)\|[a-fA-F0-9:]\+\)' | awk '{ sub(/inet6? (addr:)? ?/, \"\"); print }'"
alias flush="dscacheutil -flushcache && killall -HUP mDNSResponder"

# ==========================================
# GIT - Limpeza de branches
# ==========================================
alias git-clean-merged-branches="git fetch -p && git branch -vv | awk '/: gone]/{print \$1}' | xargs git branch -D"
alias git-clean-remove-all-branches="git branch --no-merged | egrep -v '(^\*|master|dev|main|origin)' | xargs git branch -D"
alias git-clean-branches="git gc --prune=now"

# ==========================================
# PYTHON - Troca rápida de versão via pyenv
# ==========================================
alias p3="pyenv global 3.10.4"
alias p2="pyenv global 2.7.18"

# ==========================================
# AWS - Credenciais e sessões
# ==========================================
alias edit-aws-credentials='$EDITOR ~/.aws/credentials'
alias aws-ssm='aws ssm start-session --target'
alias aws-login='rm -rf ~/.aws/boto/cache/* && get-dev-private-instances.sh'

# ==========================================
# AWS - Perfis gerais
# ==========================================
alias aws-eu='export AWS_PROFILE=eu-prod'
alias aws-us='export AWS_PROFILE=us-prod'
alias aws-dev-test='export AWS_PROFILE=us-test-dev'
alias aws-default='export AWS_PROFILE=default'
alias aws-local='export AWS_PROFILE=local'
alias aws-academy='export AWS_PROFILE=academy'

# ==========================================
# AWS - Perfis do Hermes
# ==========================================
alias aws-hermes-dev='export AWS_PROFILE=hermes-dev'
alias aws-hermes-test='export AWS_PROFILE=hermes-test'
alias aws-hermes-prod='export AWS_PROFILE=hermes-prod'

# ==========================================
# KUBERNETES - Contextos e clusters EKS
# ==========================================
alias set-kubeconfig-local='docker context use desktop-linux && kubectl config use-context docker-desktop'
alias set-gdp-kubeconfig-dev-env='aws eks update-kubeconfig --region us-west-2 --name eks-dev-1-30'
alias set-gdp-kubeconfig-test-env='aws eks update-kubeconfig --region us-west-2 --name eks-test-1-30'
alias set-gdp-kubeconfig-prod-env='aws eks update-kubeconfig --region us-west-2 --name eks-prod-1-30'
alias kubectl-default-context="kubectl config set-context docker-kubernetes"

# ==========================================
# NPM - Troca de registry por contexto
# ==========================================
alias npmg='rm -rf ~/.npmrc && cp ${POYNT_KEYS}/.npmrc-godaddy ~/.npmrc'
alias npmp='rm -rf ~/.npmrc && cp ${POYNT_KEYS}/.npmrc-poynt ~/.npmrc'
alias npmgshared='rm -rf ~/.npmrc && cp ${POYNT_KEYS}/.npmrc-godaddy-commerce-shared ~/.npmrc'
alias npmd='echo "registry=https://registry.npmjs.org" > ~/.npmrc'

# ==========================================
# JAVA - Inspeção de versões instaladas
# A troca de versão está em `.functions` (switch-java-*)
# ==========================================
alias get-java-versions="/usr/libexec/java_home -V"

# ==========================================
# ANDROID - Captura via adb
# ==========================================
alias screenshot-terminal='adb exec-out screencap -p > screenshot.png'
alias screenrecord-terminal='adbe screenrecord video.mp4'

# ==========================================
# DOCKER & COLIMA - Containers no macOS
# ==========================================
alias d='docker'
alias dc='docker compose'
alias docker-prune='docker system prune -a'
alias docker-df='docker system df'
alias cstart='colima start'
alias cstop='colima stop'
alias cstat='colima status && docker ps'

# ==========================================
# PÓS-GRADUAÇÃO - Projeto food
# ==========================================
alias connect-mysql="docker exec -it food-mysqldb-1 /bin/bash"

# ==========================================
# AGENTES DE IA - Wrappers com headroom
# A função `run-ai` está em `.functions`
# ==========================================
alias claude='run-ai claude'
alias claude-local='run-ai claude-local'
alias gemini-local="aider --model gemini/gemini-3.6-flash --no-auto-commits"
alias check-ai-models='llmfit'

# ==========================================
# AIDER - https://github.com/Aider-AI/aider
# `--edit-format whole` faz a IA reescrever o arquivo inteiro
# em vez de usar blocos SEARCH/REPLACE (mais confiável em
# modelos locais menores, porém gasta mais tokens).
# ==========================================
alias aider-local-browser="aider --model ollama_chat/qwen2.5-coder:14b --edit-format whole --no-auto-commits --browser"

# ==========================================
# OPENCLAW - Ciclo de vida e daemons
# ==========================================
alias openclaw-dashboard="openclaw dashboard"
alias openclaw-start="openclaw gateway start"
alias openclaw-stop="openclaw gateway stop"
alias openclaw-kill="openclaw gateway stop --force"
alias openclaw-restart="openclaw gateway restart"
alias openclaw-status="openclaw gateway status --deep"

# ==========================================
# OPENCLAW - Diagnóstico e logs
# ==========================================
alias openclaw-logs="openclaw logs --follow"
alias openclaw-doctor="openclaw doctor --fix"
alias openclaw-config="openclaw config show"

# ==========================================
# OPENCLAW - Gestão de modelos locais e remotos
# ==========================================
alias openclaw-models="openclaw models status"
alias openclaw-models-list="openclaw models list"
alias openclaw-refresh-models="openclaw models refresh && openclaw gateway restart"
alias openclaw-reset-full="openclaw doctor --fix && openclaw models refresh && openclaw gateway restart"

# ==========================================
# MACOS - Finder e manutenção
# ==========================================
if [[ "$OSTYPE" == darwin* ]]; then
    alias cleanup-ds-store="find . -type f -name '*.DS_Store' -ls -delete"
    alias cleanDS="cleanup-ds-store"
    alias show-finder="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
    alias hide-finder="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"
    alias showHidden='show-finder'
    alias hideHidden='hide-finder'
    alias hidedesktop="defaults write com.apple.finder CreateDesktop -bool false && killall Finder"
    alias showdesktop="defaults write com.apple.finder CreateDesktop -bool true && killall Finder"

    # ==========================================
    # MACOS - Clipboard e captura de tela
    # ==========================================
    alias cpwd='pwd | tr -d "\n" | pbcopy' # copia o path atual
    alias cl="fc -e -|pbcopy"              # copia a saída do último comando
    alias caff="caffeinate -ism"           # roda comando sem deixar o Mac dormir
    alias capc="screencapture -c"          # tela inteira -> clipboard
    alias capic="screencapture -i -c"      # seleção -> clipboard
    alias capiwc="screencapture -i -w -c"  # janela -> clipboard
fi

# ==========================================
# HTTP - Métodos via lwp-request
# Gera: GET, HEAD, POST, PUT, DELETE, TRACE, OPTIONS
# ==========================================
for method in GET HEAD POST PUT DELETE TRACE OPTIONS; do
    alias "${method}"="lwp-request -m '${method}'"
done
unset method

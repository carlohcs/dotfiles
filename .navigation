#!/usr/bin/env zsh

# ==========================================
# NAVIGATION - Substituto dos aliases de pasta
# Estratégia em 5 camadas, da mais automática à mais manual:
#   1. zoxide   -> `cd nome` pula para pasta já visitada (frecency)
#   2. cdpath   -> `cd hermes` funciona de qualquer lugar
#   3. hash -d  -> `cd ~hermes` e prompt mostra ~hermes
#   4. fzf      -> seleção interativa (Ctrl-T / Alt-C / fcd)
#   5. fsearch  -> busca em disco inteiro quando nada acima acha
# Os aliases antigos (hermes, web, mercury...) continuam
# funcionando: são gerados automaticamente a partir do mapa abaixo.
# ==========================================

# ==========================================
# ZSH OPTIONS - Navegação nativa
# AUTO_CD: digitar o nome de uma pasta já faz o cd
# AUTO_PUSHD: todo cd empilha, habilitando `cd -1`, `cd -2`...
# CDABLE_VARS: `cd DOTFILES` funciona para variáveis de path
# ==========================================
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT
setopt PUSHD_TO_HOME
setopt CDABLE_VARS
setopt EXTENDED_GLOB

# ==========================================
# MAPA DE DIRETÓRIOS - Fonte única da verdade
# Cada entrada vira: named dir (~nome), entrada no cdpath
# e alias legado (compatibilidade com a memória muscular).
# Adicione pastas novas AQUI, não em `.aliases`.
# ==========================================
typeset -A DOT_DIRS
DOT_DIRS=(
    repository        "$REPOSITORY_HOME"
    dotfiles          "$DOTFILES"
    nginx-config      "/opt/homebrew/etc/nginx"
    mission           "$REPOSITORY_HOME/missao-pessoal-all/mission"
    food              "$REPOSITORY_HOME/java/food"
    ai-tools          "$REPOSITORY_HOME/ai/tools"
    godaddy-workspace "$GODADDY_WORKSPACE"
    poynt-repositories "$GODADDY_POYNT"
    hermes            "$GODADDY_POYNT/hermes"
    mercury           "$GODADDY_POYNT/mercury"
    mercury-repo      "$GODADDY_POYNT/mercury-repo"
    web               "$GODADDY_POYNT/web"
    web-repo          "$GODADDY_POYNT/web-repo"
)

for _dot_key _dot_dir in ${(kv)DOT_DIRS}; do
    [[ -d "$_dot_dir" ]] || continue
    hash -d "${_dot_key}=${_dot_dir}"          # cd ~hermes
    alias "${_dot_key}=cd ${(q)_dot_dir}"      # compatibilidade legada
done
unset _dot_key _dot_dir

# ==========================================
# CDPATH - Pastas-pai pesquisáveis pelo `cd`
# Com isso `cd hermes` funciona de qualquer diretório,
# sem precisar de alias e com autocomplete por TAB.
# O "." na primeira posição preserva o comportamento normal.
# ==========================================
cdpath=(
    .
    "$REPOSITORY_HOME"
    "$GODADDY_POYNT"
    "$GODADDY_WORKSPACE"
    "$HOME/Documents"
    "$HOME"
)

# ==========================================
# ZOXIDE - https://github.com/ajeetdsouza/zoxide
# O "cd que aprende": `cd herm` pula para a pasta mais
# acessada cujo caminho contenha "herm".
# Instale com: brew install zoxide
# `--cmd cd` substitui o cd nativo (e mantém cd -, cd .., cd ~).
# `cdi` abre a seleção interativa via fzf.
# ==========================================
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh --cmd cd)"

    alias cdd='cdi'     # seleção interativa
    alias cd-list='zoxide query --list --score'
    alias cd-forget='zoxide remove'
elif [[ -o interactive ]]; then
    echo "⚠️  zoxide não encontrado. Instale com: brew install zoxide"
fi

# ==========================================
# LISTAGEM AUTOMÁTICA - Substitui o override de cd()
# A função cd() antiga conflitava com o zoxide.
# O hook chpwd é o jeito nativo do zsh e também dispara
# em `z`, `popd`, `cd -` e AUTO_CD.
# Lista apenas diretórios pequenos para não travar o terminal.
# ==========================================
autoload -Uz add-zsh-hook

_dotfiles_list_on_cd() {
    [[ -o interactive ]] || return 0
    [[ "$DOTFILES_FAST_SHELL" == "1" ]] && return 0

    local -a entries
    entries=(*(N))
    (( ${#entries} > 100 )) && return 0

    if command -v eza >/dev/null 2>&1; then
        eza -lh --group-directories-first --icons=auto --git
    else
        ls -A
    fi
}
add-zsh-hook chpwd _dotfiles_list_on_cd

# ==========================================
# FZF - https://github.com/junegunn/fzf
# Ctrl-T: insere arquivo | Ctrl-R: histórico | Alt-C: cd fuzzy
# Instale com: brew install fzf fd bat eza
# ==========================================
if command -v fzf >/dev/null 2>&1; then
    if command -v fd >/dev/null 2>&1; then
        export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git --exclude node_modules"
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git --exclude node_modules"
    fi

    command -v bat >/dev/null 2>&1 &&
        export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range=:200 {}'"

    command -v eza >/dev/null 2>&1 &&
        export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always {}'"

    # O plugin `fzf` do oh-my-zsh já carrega keybindings e completion.
    # Descomente se não estiver usando o plugin:
    # source <(fzf --zsh)
fi

# ==========================================
# FSEARCH - https://github.com/noahdunnagan/fsearch
# Busca no disco inteiro (macOS): nomes fuzzy com tolerância
# a erro de digitação + grep indexado dentro dos arquivos.
# ~1 ms sobre 8M de arquivos, via daemon + índice mmap.
# IMPORTANTE: o fsearch NÃO é um "pulador de pastas" — quem
# faz isso é o zoxide acima. Aqui ele acha o que o zoxide
# ainda não conhece, e as funções abaixo alimentam o zoxide
# com o resultado (fsearch -> cd -> zoxide aprende).
# Instalação: rode `fsearch-setup`
# ==========================================

# ==========================================
# FSEARCH - Instalação e manutenção do índice
# --login registra como item de login (precisa de
# Acesso Total ao Disco em Ajustes > Privacidade e Segurança).
# ==========================================
fsearch-setup() {
    local arch_tarball="fsearch-aarch64-apple-darwin.tar.gz"
    local url="https://github.com/noahdunnagan/fsearch/releases/latest/download/${arch_tarball}"

    if command -v fsearch >/dev/null 2>&1; then
        echo "✓ fsearch já instalado em: $(command -v fsearch)"
    else
        echo "⬇️  Baixando fsearch (Apple Silicon)..."
        local tmp
        tmp=$(mktemp -d) || return 1
        (
            cd "$tmp" &&
                curl -fsSL "$url" | tar xz &&
                ./fsearch install
        ) || {
            echo "✗ Falha no download. Alternativa com Rust:"
            echo "  git clone https://github.com/noahdunnagan/fsearch && cd fsearch"
            echo "  cargo build --release && ./target/release/fsearch install"
            return 1
        }
        rm -rf "$tmp"
    fi

    mkdir -p "$FSEARCH_HOME"

    # Pastas que não valem indexação de conteúdo
    if [[ ! -f "$FSEARCH_SKIP_FILE" ]]; then
        cat >"$FSEARCH_SKIP_FILE" <<'EOF'
# Pastas ignoradas na indexação de CONTEÚDO (nomes continuam indexados)
# Uma por linha. `~` e comentários com `#` funcionam.
~/Library/Caches
~/.Trash
~/.npm
~/.pnpm-store
~/.cargo/registry
~/.gradle
~/.m2/repository
~/.asdf
~/.pyenv
~/.proto
~/.bun/install/cache
~/.colima
~/Library/Containers
~/Library/Application Support/Docker Desktop
EOF
        echo "✓ Lista de exclusões criada em: $FSEARCH_SKIP_FILE"
    fi

    echo ""
    echo "Próximos passos opcionais:"
    echo "  fsearch install --login   # roda como item de login"
    echo "  Ajustes > Privacidade e Segurança > Acesso Total ao Disco"
    echo "    -> adicione ~/.local/bin/fsearch (refazer após cada rebuild)"
}

alias fsearch-skip='$EDITOR "$FSEARCH_SKIP_FILE"'
alias fsearch-reindex='fsearch install'

# O oh-my-zsh (plugin common-aliases) define `alias ff='find . -type f -name'`.
# O zsh expande aliases ao PARSEAR, então `ff() {` vira erro de sintaxe e o
# arquivo inteiro deixa de carregar. Por isso as funções abaixo usam a forma
# `function nome {` (sem expansão de alias) e o unalias remove o alias antigo.
unalias ff fcd fgr fsym fgit 2>/dev/null

if command -v fsearch >/dev/null 2>&1; then

    # ==========================================
    # ff - Buscar arquivo por nome e abrir no editor
    # Uso: ff main.rs | ff mian.rs (tolera typo) | ff 'readme in:~/Documents'
    # ==========================================
    function ff {
        local query="$*"
        [[ -z "$query" ]] && { echo "Uso: ff <nome-ou-query>"; return 1; }

        local file
        file=$(fsearch "$query limit:200" 2>/dev/null |
            fzf --prompt='fsearch > ' \
                --preview 'bat --style=numbers --color=always --line-range=:200 {} 2>/dev/null || ls -la {}')

        [[ -n "$file" ]] && "$EDITOR" "$file"
    }

    # ==========================================
    # fcd - Buscar no disco e entrar na pasta do resultado
    # Fecha o ciclo: o destino escolhido é gravado no zoxide,
    # então na próxima vez basta `cd <fragmento>`.
    # Uso: fcd hermes | fcd 'type:folder mercury'
    # ==========================================
    function fcd {
        local query="$*"
        [[ -z "$query" ]] && { echo "Uso: fcd <nome>"; return 1; }

        local hit dir
        hit=$(fsearch "$query limit:200" 2>/dev/null |
            fzf --prompt='fsearch cd > ' \
                --preview 'ls -la "$(dirname {})" 2>/dev/null')

        [[ -z "$hit" ]] && return 0
        [[ -d "$hit" ]] && dir="$hit" || dir="$(dirname "$hit")"

        command -v zoxide >/dev/null 2>&1 && zoxide add "$dir"
        builtin cd "$dir" || return 1
    }

    # ==========================================
    # fgr - Grep indexado dentro dos arquivos
    # Uso: fgr apply_dir | fgr 'ext:rs grep:apply_dir'
    # ==========================================
    function fgr {
        local pattern="$*"
        [[ -z "$pattern" ]] && { echo "Uso: fgr <padrão>"; return 1; }

        case "$pattern" in
        *grep:* | *regex:*) fsearch "$pattern" ;;
        *) fsearch "grep:$pattern limit:100" ;;
        esac
    }

    # ==========================================
    # fsym - Onde um símbolo está definido
    # Uso: fsym apply_dir
    # ==========================================
    function fsym {
        [[ -z "$1" ]] && { echo "Uso: fsym <símbolo>"; return 1; }
        fsearch "sym:$1 limit:50"
    }

    # ==========================================
    # fgit - Arquivos modificados em um projeto
    # Uso: fgit ~/Documents/repository/dotfiles
    # ==========================================
    function fgit {
        local dir="${1:-$PWD}"
        fsearch "git:modified in:$dir"
    }

else
    # ==========================================
    # FALLBACK - fd + fzf enquanto o fsearch não está instalado
    # ==========================================
    function fcd {
        command -v fd >/dev/null 2>&1 || { echo "Instale fd ou rode fsearch-setup"; return 1; }
        local dir
        dir=$(fd --type d --hidden --exclude .git . "${1:-$HOME}" | fzf --prompt='cd > ')
        [[ -n "$dir" ]] && { command -v zoxide >/dev/null 2>&1 && zoxide add "$dir"; builtin cd "$dir"; }
    }
fi

# ==========================================
# FSEARCH MCP - Servidor MCP para agentes de código
# `fsearch mcp` expõe find_files, grep e multi_grep via stdio.
# Registre no Claude Code com:
#   claude mcp add fsearch -- fsearch mcp
# Descomente para registrar automaticamente na primeira carga:
# command -v claude >/dev/null 2>&1 && claude mcp add fsearch -- fsearch mcp 2>/dev/null
# ==========================================
alias fsearch-mcp='fsearch mcp'
alias fsearch-mcp-register='claude mcp add fsearch -- fsearch mcp'

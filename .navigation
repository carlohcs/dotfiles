#!/usr/bin/env zsh

# ==========================================
# NAVIGATION - Replacement for folder aliases
# 5-layer strategy, from most automatic to most manual:
#   1. zoxide   -> `cd name` jumps to an already-visited folder (frecency)
#   2. cdpath   -> `cd hermes` works from anywhere
#   3. hash -d  -> `cd ~hermes` and the prompt shows ~hermes
#   4. fzf      -> interactive selection (Ctrl-T / Alt-C / fcd)
#   5. fsearch  -> whole-disk search when none of the above find it
# The old aliases (hermes, web, mercury...) keep working:
# they're generated automatically from the map below.
# ==========================================

# ==========================================
# ZSH OPTIONS - Native navigation
# AUTO_CD: typing a folder name alone does the cd
# AUTO_PUSHD: every cd is pushed, enabling `cd -1`, `cd -2`...
# CDABLE_VARS: `cd DOTFILES` works for path variables
# ==========================================
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT
setopt PUSHD_TO_HOME
setopt CDABLE_VARS
setopt EXTENDED_GLOB

# ==========================================
# DIRECTORY MAP - Single source of truth
# Each entry becomes: a named dir (~name), a cdpath entry
# and a legacy alias (muscle-memory compatibility).
# Add new folders HERE, not in `.aliases`.
# ==========================================
typeset -A DOT_DIRS
DOT_DIRS=(
    repository        "$REPOSITORY_HOME"
    dotfiles          "$DOTFILES"
    nginx-config      "/opt/homebrew/etc/nginx"
    mission           "$REPOSITORY_HOME/missao-pessoal-all/mission"
    food              "$REPOSITORY_HOME/java/food"
    ai-tools          "$REPOSITORY_HOME/ai/tools"
    godaddy-workspace "$GODADDY_WORKSPACE"
    poynt-repositories "$GODADDY_POYNT"
    hermes            "$GODADDY_POYNT/hermes"
    mercury           "$GODADDY_POYNT/mercury"
    mercury-repo      "$GODADDY_POYNT/mercury-repo"
    web               "$GODADDY_POYNT/web"
    web-repo          "$GODADDY_POYNT/web-repo"
)

for _dot_key _dot_dir in ${(kv)DOT_DIRS}; do
    [[ -d "$_dot_dir" ]] || continue
    hash -d "${_dot_key}=${_dot_dir}"          # cd ~hermes
    alias "${_dot_key}=cd ${(q)_dot_dir}"      # legacy compatibility
done
unset _dot_key _dot_dir

# ==========================================
# CDPATH - Parent folders searchable by `cd`
# This makes `cd hermes` work from any directory,
# with no alias needed and TAB autocomplete.
# The "." in the first position preserves normal behavior.
# ==========================================
cdpath=(
    .
    "$REPOSITORY_HOME"
    "$GODADDY_POYNT"
    "$GODADDY_WORKSPACE"
    "$HOME/Documents"
    "$HOME"
)

# ==========================================
# ZOXIDE - https://github.com/ajeetdsouza/zoxide
# The "cd that learns": `cd herm` jumps to the most
# accessed folder whose path contains "herm".
# Install with: brew install zoxide
# `--cmd cd` replaces the native cd (and keeps cd -, cd .., cd ~).
# `cdi` opens the interactive fzf picker.
# ==========================================
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh --cmd cd)"

    alias cdd='cdi'     # interactive selection
    alias cd-list='zoxide query --list --score'
    alias cd-forget='zoxide remove'
elif [[ -o interactive ]]; then
    echo "⚠️  zoxide not found. Install with: brew install zoxide"
fi

# ==========================================
# AUTOMATIC LISTING - Replaces the cd() override
# The old cd() function conflicted with zoxide.
# The chpwd hook is zsh's native way and also fires
# on `z`, `popd`, `cd -` and AUTO_CD.
# Only lists small directories to avoid freezing the terminal.
# ==========================================
autoload -Uz add-zsh-hook

_dotfiles_list_on_cd() {
    [[ -o interactive ]] || return 0
    [[ "$DOTFILES_FAST_SHELL" == "1" ]] && return 0

    local -a entries
    entries=(*(N))
    (( ${#entries} > 100 )) && return 0

    if command -v eza >/dev/null 2>&1; then
        eza -lh --group-directories-first --icons=auto --git
    else
        ls -A
    fi
}
add-zsh-hook chpwd _dotfiles_list_on_cd

# ==========================================
# FZF - https://github.com/junegunn/fzf
# Ctrl-T: insert file | Ctrl-R: history | Alt-C: fuzzy cd
# Install with: brew install fzf fd bat eza
# ==========================================
if command -v fzf >/dev/null 2>&1; then
    if command -v fd >/dev/null 2>&1; then
        export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git --exclude node_modules"
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git --exclude node_modules"
    fi

    command -v bat >/dev/null 2>&1 &&
        export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range=:200 {}'"

    command -v eza >/dev/null 2>&1 &&
        export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always {}'"

    # oh-my-zsh's `fzf` plugin already loads keybindings and completion.
    # Uncomment if you're not using the plugin:
    # source <(fzf --zsh)
fi

# ==========================================
# FSEARCH - https://github.com/noahdunnagan/fsearch
# Whole-disk search (macOS): fuzzy names with typo
# tolerance + indexed grep inside files.
# ~1 ms over 8M files, via daemon + mmap index.
# IMPORTANT: fsearch is NOT a "folder jumper" — zoxide
# above does that. Here it finds what zoxide doesn't
# know yet, and the functions below feed zoxide
# with the result (fsearch -> cd -> zoxide learns).
# Installation: run `fsearch-setup`
# ==========================================

# ==========================================
# FSEARCH - Index installation and maintenance
# --login registers it as a login item (needs
# Full Disk Access in Settings > Privacy & Security).
# ==========================================
fsearch-setup() {
    local arch_tarball="fsearch-aarch64-apple-darwin.tar.gz"
    local url="https://github.com/noahdunnagan/fsearch/releases/latest/download/${arch_tarball}"

    if command -v fsearch >/dev/null 2>&1; then
        echo "✓ fsearch already installed at: $(command -v fsearch)"
    else
        echo "⬇️  Downloading fsearch (Apple Silicon)..."
        local tmp
        tmp=$(mktemp -d) || return 1
        (
            cd "$tmp" &&
                curl -fsSL "$url" | tar xz &&
                ./fsearch install
        ) || {
            echo "✗ Download failed. Rust alternative:"
            echo "  git clone https://github.com/noahdunnagan/fsearch && cd fsearch"
            echo "  cargo build --release && ./target/release/fsearch install"
            return 1
        }
        rm -rf "$tmp"
    fi

    mkdir -p "$FSEARCH_HOME"

    # Folders not worth indexing by content
    if [[ ! -f "$FSEARCH_SKIP_FILE" ]]; then
        cat >"$FSEARCH_SKIP_FILE" <<'EOF'
# Folders skipped from CONTENT indexing (names are still indexed)
# One per line. `~` and `#` comments work.
~/Library/Caches
~/.Trash
~/.npm
~/.pnpm-store
~/.cargo/registry
~/.gradle
~/.m2/repository
~/.asdf
~/.pyenv
~/.proto
~/.bun/install/cache
~/.colima
~/Library/Containers
~/Library/Application Support/Docker Desktop
EOF
        echo "✓ Skip list created at: $FSEARCH_SKIP_FILE"
    fi

    echo ""
    echo "Optional next steps:"
    echo "  fsearch install --login   # runs as a login item"
    echo "  Settings > Privacy & Security > Full Disk Access"
    echo "    -> add ~/.local/bin/fsearch (redo after each rebuild)"
}

alias fsearch-skip='$EDITOR "$FSEARCH_SKIP_FILE"'
alias fsearch-reindex='fsearch install'

# oh-my-zsh (common-aliases plugin) defines `alias ff='find . -type f -name'`.
# zsh expands aliases while PARSING, so `ff() {` becomes a syntax error and the
# whole file stops loading. That's why the functions below use the
# `function name {` form (no alias expansion), and unalias removes the old alias.
unalias ff fcd fgr fsym fgit 2>/dev/null

if command -v fsearch >/dev/null 2>&1; then

    # ==========================================
    # ff - Find a file by name and open it in the editor
    # Usage: ff main.rs | ff mian.rs (typo tolerant) | ff 'readme in:~/Documents'
    # ==========================================
    function ff {
        local query="$*"
        [[ -z "$query" ]] && { echo "Usage: ff <name-or-query>"; return 1; }

        local file
        file=$(fsearch "$query limit:200" 2>/dev/null |
            fzf --prompt='fsearch > ' \
                --preview 'bat --style=numbers --color=always --line-range=:200 {} 2>/dev/null || ls -la {}')

        [[ -n "$file" ]] && "$EDITOR" "$file"
    }

    # ==========================================
    # fcd - Search the disk and enter the result's folder
    # Closes the loop: the chosen destination is written to zoxide,
    # so next time plain `cd <fragment>` is enough.
    # Usage: fcd hermes | fcd 'type:folder mercury'
    # ==========================================
    function fcd {
        local query="$*"
        [[ -z "$query" ]] && { echo "Usage: fcd <name>"; return 1; }

        local hit dir
        hit=$(fsearch "$query limit:200" 2>/dev/null |
            fzf --prompt='fsearch cd > ' \
                --preview 'ls -la "$(dirname {})" 2>/dev/null')

        [[ -z "$hit" ]] && return 0
        [[ -d "$hit" ]] && dir="$hit" || dir="$(dirname "$hit")"

        command -v zoxide >/dev/null 2>&1 && zoxide add "$dir"
        builtin cd "$dir" || return 1
    }

    # ==========================================
    # fgr - Indexed grep inside files
    # Usage: fgr apply_dir | fgr 'ext:rs grep:apply_dir'
    # ==========================================
    function fgr {
        local pattern="$*"
        [[ -z "$pattern" ]] && { echo "Usage: fgr <pattern>"; return 1; }

        case "$pattern" in
        *grep:* | *regex:*) fsearch "$pattern" ;;
        *) fsearch "grep:$pattern limit:100" ;;
        esac
    }

    # ==========================================
    # fsym - Where a symbol is defined
    # Usage: fsym apply_dir
    # ==========================================
    function fsym {
        [[ -z "$1" ]] && { echo "Usage: fsym <symbol>"; return 1; }
        fsearch "sym:$1 limit:50"
    }

    # ==========================================
    # fgit - Files modified in a project
    # Usage: fgit ~/Documents/repository/dotfiles
    # ==========================================
    function fgit {
        local dir="${1:-$PWD}"
        fsearch "git:modified in:$dir"
    }

else
    # ==========================================
    # FALLBACK - fd + fzf while fsearch isn't installed
    # ==========================================
    function fcd {
        command -v fd >/dev/null 2>&1 || { echo "Install fd or run fsearch-setup"; return 1; }
        local dir
        dir=$(fd --type d --hidden --exclude .git . "${1:-$HOME}" | fzf --prompt='cd > ')
        [[ -n "$dir" ]] && { command -v zoxide >/dev/null 2>&1 && zoxide add "$dir"; builtin cd "$dir"; }
    }
fi

# ==========================================
# FSEARCH MCP - MCP server for coding agents
# `fsearch mcp` exposes find_files, grep and multi_grep via stdio.
# Register it with Claude Code:
#   claude mcp add fsearch -- fsearch mcp
# Uncomment to register automatically on first load:
# command -v claude >/dev/null 2>&1 && claude mcp add fsearch -- fsearch mcp 2>/dev/null
# ==========================================
alias fsearch-mcp='fsearch mcp'
alias fsearch-mcp-register='claude mcp add fsearch -- fsearch mcp'

#!/usr/bin/env zsh

# ==========================================
# EXTRAS - Catalog of optional tools
# EVERYTHING here is commented out on purpose.
# Uncomment only what you'll use — every extra line
# costs milliseconds at terminal startup.
# Measure before optimizing:  time zsh -i -c exit
# ==========================================

# ==========================================
# ZOXIDE - https://github.com/ajeetdsouza/zoxide
# Already active in `.navigation`. Left here as a reference.
# brew install zoxide
# eval "$(zoxide init zsh --cmd cd)"
# ==========================================

# ==========================================
# EZA - https://github.com/eza-community/eza
# Modern `ls` replacement: icons, git status and tree view.
# Already used automatically by the listing hook if present.
# brew install eza
alias ls='eza -lh --git --group-directories-first --icons=auto'
alias ll='eza -lah --git --group-directories-first --icons=auto'
alias lt='eza --tree --level=2 --icons=auto'
# ==========================================

# ==========================================
# FD - https://github.com/sharkdp/fd
# `find` replacement, respects .gitignore. Feeds fzf.
# brew install fd
# alias find-files='fd'
# ==========================================

# ==========================================
# RIPGREP - https://github.com/BurntSushi/ripgrep
# Fast recursive grep. Complements fsearch's `fgr`
# when you want to search only inside the current project.
# brew install ripgrep
# alias rgf='rg --files-with-matches'
# ==========================================

# ==========================================
# ATUIN - https://github.com/atuinsh/atuin
# Shell history in SQLite, with fuzzy search, context
# (folder, host, exit code) and E2E sync across machines.
# Warp note: disable the Ctrl-R keybinding so it doesn't
# clash with the native search (`--disable-up-arrow` helps).
# brew install atuin
# eval "$(atuin init zsh --disable-up-arrow)"
# ==========================================

# ==========================================
# DIRENV - https://github.com/direnv/direnv
# Loads/unloads variables per directory via `.envrc`.
# Solves the back-and-forth of AWS_PROFILE and tokens per project.
# brew install direnv
# eval "$(direnv hook zsh)"
# ==========================================

# ==========================================
# MISE - https://github.com/jdx/mise
# Replaces asdf + pyenv + nvm + proto with a single binary,
# much faster at startup. A candidate to consolidate
# the 4 version managers currently living in `.bootstrap`.
# brew install mise
# eval "$(mise activate zsh)"
# ==========================================

# ==========================================
# ZSH-DEFER - https://github.com/romkatv/zsh-defer
# Defers initialization of slow things (gcloud,
# completions) until after the first prompt shows up.
# git clone https://github.com/romkatv/zsh-defer ~/.zsh-defer
# source ~/.zsh-defer/zsh-defer.plugin.zsh
# zsh-defer source ~/google-cloud-sdk/completion.zsh.inc
# ==========================================

# ==========================================
# FZF-TAB - https://github.com/Aloxaf/fzf-tab
# Replaces zsh's completion menu with an fzf window.
# Note: may conflict with Warp's native autocomplete —
# test before committing to it.
# git clone https://github.com/Aloxaf/fzf-tab ~/.fzf-tab
# source ~/.fzf-tab/fzf-tab.plugin.zsh
# ==========================================

# ==========================================
# DELTA - https://github.com/dandavison/delta
# Git diff with syntax highlighting and side-by-side view.
# brew install git-delta
# git config --global core.pager delta
# git config --global delta.navigate true
# ==========================================

# ==========================================
# LAZYGIT - https://github.com/jesseduffield/lazygit
# Git TUI. Interactive rebase and stash without memorizing commands.
# brew install lazygit
# alias lg='lazygit'
# ==========================================

# ==========================================
# LAZYDOCKER - https://github.com/jesseduffield/lazydocker
# Container TUI. Pairs well with the Colima setup.
# brew install lazydocker
# alias lzd='lazydocker'
# ==========================================

# ==========================================
# K9S - https://github.com/derailed/k9s
# Kubernetes TUI. Replaces most of the kubectl aliases
# and the `get-hermes-pods` / `connect-hermes-pod` functions.
# brew install k9s
# alias k9='k9s --namespace gdp'
# ==========================================

# ==========================================
# NAVI - https://github.com/denisidoro/navi
# Interactive cheatsheet that pastes the command into the prompt.
# Alternative to Warp Workflows when you're outside Warp.
# brew install navi
# eval "$(navi widget zsh)"
# ==========================================

# ==========================================
# TEALDEER - https://github.com/tealdeer-rs/tealdeer
# Fast tldr client: practical examples instead of man pages.
# brew install tealdeer
# alias help='tldr'
# ==========================================

# ==========================================
# BTOP - https://github.com/aristocratos/btop
# Resource monitor. Useful to see what Colima's VM is eating.
# brew install btop
alias top='btop'
# ==========================================

# ==========================================
# DUST / DUF - https://github.com/bootandy/dust
#              https://github.com/muesli/duf
# Readable disk usage. Good pairing with `docker-df`.
# brew install dust duf
# alias du='dust'
# alias df='duf'
# ==========================================

# ==========================================
# PAY-RESPECTS - https://github.com/iffse/pay-respects
# Fixes the last mistyped command (thefuck's successor).
# brew install pay-respects
# eval "$(pay-respects zsh --alias fk)"
# ==========================================

# ==========================================
# WARP THEMES - https://github.com/warpdotdev/themes
# Official themes repository. Ready-made helper in `.warp-config`:
# warp-install-themes
# ==========================================

# ==========================================
# WARP WORKFLOWS - https://github.com/warpdotdev/workflows
# YAML specs for the public workflows (also on commands.dev).
# Good examples before writing your own with `warp-new-workflow`.
# git clone https://github.com/warpdotdev/workflows /tmp/warp-workflows
# ==========================================

# ==========================================
# FSEARCH - https://github.com/noahdunnagan/fsearch
# Whole-disk search on macOS. Setup and functions
# (ff, fcd, fgr, fsym, fgit) already live in `.navigation`.
# fsearch-setup
# ==========================================
